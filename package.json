{
  "name": "yaffle-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "yaffle: Yet Another File-Format Language & Engine",
  "type": "module",
  "workspaces": [
    "packages/runtime",
    "packages/compiler",
    "packages/lsp",
    "packages/vscode",
    "conformance"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages conformance",
    "lint:fix": "eslint packages conformance --fix",
    "format": "prettier -w -l packages conformance docs",
    "format:check": "prettier -c packages conformance",
    "prepare": "husky",
    "release": "node .github/scripts/release.ts"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier -w -l",
      "eslint --fix"
    ]
  },
  "prettier": {
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": false,
    "trailingComma": "none",
    "printWidth": 100,
    "semi": true,
    "arrowParens": "avoid"
  },
  "author": "Noah",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
