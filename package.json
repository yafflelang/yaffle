{
  "name": "minibin2",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepack": "npm run lint:fix && npm run format && npm run build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier -w -l src",
    "format:check": "prettier -c src",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "prettier -w -l",
      "eslint --fix"
    ]
  },
  "prettier": {
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": false,
    "trailingComma": "none",
    "printWidth": 80,
    "semi": true,
    "arrowParens": "avoid"
  },
  "author": "Noah",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
