{
  "name": "yaffle",
  "version": "0.0.3",
  "description": "A language for describing binary file formats, compiled to typed readers and writers",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./service": {
      "development": "./src/service/index.ts",
      "types": "./dist/service/index.d.ts",
      "default": "./dist/service/index.js"
    },
    "./ir": {
      "development": "./src/ir/index.ts",
      "types": "./dist/ir/index.d.ts",
      "default": "./dist/ir/index.js"
    }
  },
  "bin": {
    "yaffle": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "yaffle": "node --conditions=development src/cli/main.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@yafflelang/runtime": "0.0.3"
  },
  "license": "ISC",
  "keywords": [
    "binary",
    "file-format",
    "parser",
    "serializer",
    "codegen",
    "kaitai",
    "dsl",
    "compiler"
  ],
  "author": "Noah",
  "homepage": "https://yafflelang.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yafflelang/yaffle.git",
    "directory": "packages/compiler"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
