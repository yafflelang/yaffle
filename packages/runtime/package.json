{
  "name": "@yaffle/runtime",
  "version": "0.1.0",
  "description": "Runtime for code generated by the yaffle compiler (TypeScript target)",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "license": "ISC"
}
