{
  "name": "@yafflelang/runtime",
  "version": "0.0.3",
  "description": "Runtime for TypeScript code generated by the yaffle compiler",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "license": "ISC",
  "keywords": [
    "yaffle",
    "binary",
    "runtime"
  ],
  "author": "Noah",
  "homepage": "https://yafflelang.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yafflelang/yaffle.git",
    "directory": "packages/runtime"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
