{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "yaffle",
  "scopeName": "source.yaffle",
  "fileTypes": ["yfl"],
  "patterns": [{ "include": "#statements" }],
  "repository": {
    "statements": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#import" },
        { "include": "#export" },
        { "include": "#const" },
        { "include": "#extern" },
        { "include": "#struct" },
        { "include": "#union" },
        { "include": "#enum" },
        { "include": "#bits" },
        { "include": "#type-declaration" },
        { "include": "#layout" },
        { "include": "#control" },
        { "include": "#attributes" },
        { "include": "#field-clauses" },
        { "include": "#virtual" },
        { "include": "#field-declaration" },
        { "include": "#block" },
        { "include": "#brackets" },
        { "include": "#parens" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#bound-values" },
        { "include": "#primitive-types" },
        {
          "match": "(:)(?!:)",
          "captures": { "1": { "name": "punctuation.separator.colon.yaffle" } }
        },
        { "match": "\\*", "name": "keyword.operator.pointer.yaffle" },
        { "match": ";", "name": "punctuation.terminator.statement.yaffle" },
        { "match": ",", "name": "punctuation.separator.comma.yaffle" },
        { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "entity.name.type.yaffle" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.yaffle",
          "begin": "\\/\\*\\*(?!\\/)",
          "end": "\\*\\/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.yaffle" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.yaffle" } }
        },
        {
          "name": "comment.block.yaffle",
          "begin": "\\/\\*",
          "end": "\\*\\/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.yaffle" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.yaffle" } }
        },
        {
          "name": "comment.line.double-slash.yaffle",
          "begin": "\\/\\/",
          "end": "$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.yaffle" } }
        }
      ]
    },
    "import": {
      "name": "meta.import.yaffle",
      "begin": "\\b(import)\\b",
      "beginCaptures": { "1": { "name": "keyword.control.import.yaffle" } },
      "end": "$|;",
      "endCaptures": { "0": { "name": "punctuation.terminator.statement.yaffle" } },
      "patterns": [
        { "include": "#comments" },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.block.begin.yaffle" } },
          "endCaptures": { "0": { "name": "punctuation.definition.block.end.yaffle" } },
          "patterns": [
            { "include": "#comments" },
            {
              "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "keyword.control.as.yaffle" },
                "2": { "name": "variable.other.readwrite.alias.yaffle" }
              }
            },
            {
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
              "name": "variable.other.readwrite.alias.yaffle"
            },
            { "match": ",", "name": "punctuation.separator.comma.yaffle" }
          ]
        },
        {
          "match": "(\\*)\\s*\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "constant.language.import-export-all.yaffle" },
            "2": { "name": "keyword.control.as.yaffle" },
            "3": { "name": "entity.name.namespace.yaffle" }
          }
        },
        { "match": "\\bfrom\\b", "name": "keyword.control.from.yaffle" },
        { "include": "#string-double" }
      ]
    },
    "export": { "match": "\\bexport\\b", "name": "keyword.control.export.yaffle" },
    "const": {
      "name": "meta.const.yaffle",
      "begin": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.const.yaffle" },
        "2": { "patterns": [{ "include": "#type-name" }] },
        "3": { "name": "variable.other.constant.yaffle" }
      },
      "end": "(?=;|\\/\\/|\\/\\*)|$",
      "patterns": [
        { "match": "=", "name": "keyword.operator.assignment.yaffle" },
        { "include": "#expression" }
      ]
    },
    "extern": {
      "patterns": [
        { "match": "\\bextern\\b", "name": "storage.modifier.extern.yaffle" },
        { "match": "\\basync\\b", "name": "storage.modifier.async.yaffle" },
        {
          "comment": "extern fn name(params) -> Type",
          "name": "meta.function.yaffle",
          "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "storage.type.function.yaffle" },
            "2": { "name": "entity.name.function.yaffle" }
          },
          "end": "(?=;|\\/\\/|\\/\\*)|$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#parameters" },
            { "match": "->", "name": "keyword.operator.arrow.yaffle" },
            { "include": "#attributes" },
            { "include": "#brackets" },
            { "include": "#type-name" }
          ]
        },
        {
          "comment": "extern codec name(params) @attrs",
          "name": "meta.codec.yaffle",
          "begin": "\\b(codec)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "storage.type.codec.yaffle" },
            "2": { "name": "entity.name.function.codec.yaffle" }
          },
          "end": "(?=;|\\/\\/|\\/\\*)|$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#parameters" },
            { "include": "#attributes" }
          ]
        }
      ]
    },
    "struct": {
      "comment": "The struct header; its `{ … }` body is a #block.",
      "name": "meta.struct.yaffle",
      "begin": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.struct.yaffle" },
        "2": { "name": "entity.name.type.struct.yaffle" }
      },
      "end": "(?=\\{|;)|$",
      "patterns": [
        { "include": "#comments" },
        { "include": "#type-parameters" },
        { "include": "#parameters" },
        { "include": "#attributes" }
      ]
    },
    "union": {
      "name": "meta.union.yaffle",
      "begin": "\\b(union)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.union.yaffle" },
        "2": { "name": "entity.name.type.union.yaffle" }
      },
      "end": "(?<=\\})|(?=;)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#type-parameters" },
        { "include": "#parameters" },
        { "include": "#attributes" },
        {
          "name": "meta.union.body.yaffle",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.block.begin.yaffle" } },
          "endCaptures": { "0": { "name": "punctuation.definition.block.end.yaffle" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#attributes" },
            { "include": "#type-arguments" },
            { "include": "#call-parens" },
            { "match": "[,;]", "name": "punctuation.separator.comma.yaffle" },
            { "include": "#type-name" }
          ]
        }
      ]
    },
    "enum": {
      "name": "meta.enum.yaffle",
      "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.enum.yaffle" },
        "2": { "name": "entity.name.type.enum.yaffle" }
      },
      "end": "(?<=\\})|(?=;)",
      "patterns": [
        { "include": "#comments" },
        { "match": ":", "name": "punctuation.separator.colon.yaffle" },
        { "include": "#attributes" },
        {
          "name": "meta.enum.body.yaffle",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.block.begin.yaffle" } },
          "endCaptures": { "0": { "name": "punctuation.definition.block.end.yaffle" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#attributes" },
            {
              "begin": "=",
              "beginCaptures": { "0": { "name": "keyword.operator.assignment.yaffle" } },
              "end": "(?=[,}]|\\/\\/|\\/\\*)|$",
              "patterns": [{ "include": "#expression" }]
            },
            { "match": ",", "name": "punctuation.separator.comma.yaffle" },
            { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "variable.other.enummember.yaffle" }
          ]
        },
        { "include": "#type-name" }
      ]
    },
    "bits": {
      "match": "\\b(bits)\\b",
      "captures": { "1": { "name": "storage.type.bits.yaffle" } }
    },
    "type-declaration": {
      "comment": "type Name<T>(params) = Type …  and  extern type Name(params) : T @size(n)",
      "name": "meta.type.declaration.yaffle",
      "begin": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.type.yaffle" },
        "2": { "name": "entity.name.type.alias.yaffle" }
      },
      "end": "(?=;|\\/\\/|\\/\\*)|$",
      "patterns": [
        { "include": "#comments" },
        { "include": "#type-parameters" },
        { "include": "#parameters" },
        { "match": ":", "name": "punctuation.separator.colon.yaffle" },
        {
          "begin": "=",
          "beginCaptures": { "0": { "name": "keyword.operator.assignment.yaffle" } },
          "end": "(?=;|\\/\\/|\\/\\*)|$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#attributes" },
            { "include": "#field-clauses" },
            { "include": "#brackets" },
            { "include": "#type-arguments" },
            { "include": "#call-parens" },
            { "include": "#type-name" }
          ]
        },
        { "include": "#attributes" },
        { "include": "#type-name" }
      ]
    },
    "layout": {
      "name": "meta.layout.yaffle",
      "begin": "\\b(layout)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.other.layout.yaffle" },
        "2": { "name": "punctuation.definition.block.begin.yaffle" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.block.end.yaffle" } },
      "patterns": [{ "include": "#layout-items" }]
    },
    "layout-items": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#attributes" },
        { "include": "#wildcard" },
        {
          "comment": "A per-element group: volumes[*] { pieces[*]  portals[*].points }",
          "name": "meta.layout.group.yaffle",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.block.begin.yaffle" } },
          "endCaptures": { "0": { "name": "punctuation.definition.block.end.yaffle" } },
          "patterns": [{ "include": "#layout-items" }]
        },
        { "match": "\\bthis\\b", "name": "variable.language.this.yaffle" },
        { "match": "\\.", "name": "punctuation.accessor.yaffle" },
        { "match": ",", "name": "punctuation.separator.comma.yaffle" },
        { "include": "#brackets" },
        { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "variable.other.property.yaffle" }
      ]
    },
    "virtual": {
      "comment": "virtual u40 size = (sizeHigh << 32) | sizeLow",
      "match": "\\b(virtual)\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*)",
      "captures": { "1": { "name": "storage.modifier.virtual.yaffle" } }
    },
    "control": {
      "patterns": [
        { "match": "\\b(if)\\b", "captures": { "1": { "name": "keyword.control.if.yaffle" } } },
        { "match": "\\b(else)\\b", "captures": { "1": { "name": "keyword.control.else.yaffle" } } },
        {
          "match": "\\b(switch)\\b",
          "captures": { "1": { "name": "keyword.control.switch.yaffle" } }
        },
        {
          "name": "meta.case.yaffle",
          "begin": "\\b(case)\\b",
          "beginCaptures": { "1": { "name": "keyword.control.case.yaffle" } },
          "end": ":(?!:)",
          "endCaptures": { "0": { "name": "punctuation.separator.case.yaffle" } },
          "patterns": [{ "include": "#expression" }]
        },
        {
          "match": "\\b(default)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.control.default.yaffle" },
            "2": { "name": "punctuation.separator.case.yaffle" }
          }
        }
      ]
    },
    "block": {
      "name": "meta.block.yaffle",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.block.begin.yaffle" } },
      "endCaptures": { "0": { "name": "punctuation.definition.block.end.yaffle" } },
      "patterns": [{ "include": "#statements" }]
    },
    "field-declaration": {
      "comment": "A declaration: Type<Args>(args) *name — the name is a variable.other.member.yaffle",
      "match": "\\b(?!(?:struct|union|enum|bits|type|extern|codec|const|import|export|layout|switch|case|default|if|else|at|from|as|in|where|until|fn|async|virtual)\\b)((?:[A-Za-z_][A-Za-z0-9_]*\\s*\\.\\s*)*[A-Za-z_][A-Za-z0-9_]*)(\\s*<(?:[^<>]|<[^<>]*>)*>)?(\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s*(\\*\\s*)?(?!(?:in|as|where|at|from|until)\\b)(\\$?[A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from)\\b|\\s+[A-Za-z_$*])",
      "captures": {
        "1": { "patterns": [{ "include": "#type-name" }] },
        "2": { "patterns": [{ "include": "#type-arguments" }] },
        "3": { "patterns": [{ "include": "#call-parens" }] },
        "4": { "name": "keyword.operator.pointer.yaffle" },
        "5": {
          "patterns": [
            { "include": "#bound-values" },
            { "match": ".+", "name": "variable.other.member.yaffle" }
          ]
        }
      }
    },
    "parameter-declaration": {
      "comment": "A declaration: Type<Args>(args) *name — the name is a variable.parameter.yaffle",
      "match": "\\b(?!(?:struct|union|enum|bits|type|extern|codec|const|import|export|layout|switch|case|default|if|else|at|from|as|in|where|until|fn|async|virtual)\\b)((?:[A-Za-z_][A-Za-z0-9_]*\\s*\\.\\s*)*[A-Za-z_][A-Za-z0-9_]*)(\\s*<(?:[^<>]|<[^<>]*>)*>)?(\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s*(\\*\\s*)?(?!(?:in|as|where|at|from|until)\\b)(\\$?[A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from)\\b|\\s+[A-Za-z_$*])",
      "captures": {
        "1": { "patterns": [{ "include": "#type-name" }] },
        "2": { "patterns": [{ "include": "#type-arguments" }] },
        "3": { "patterns": [{ "include": "#call-parens" }] },
        "4": { "name": "keyword.operator.pointer.yaffle" },
        "5": {
          "patterns": [
            { "include": "#bound-values" },
            { "match": ".+", "name": "variable.parameter.yaffle" }
          ]
        }
      }
    },
    "field-clauses": {
      "comment": "Read-side expressions after a field: = formula, as, where, in, at, from",
      "patterns": [
        { "include": "#regex-in" },
        {
          "begin": "\\b(in)\\b",
          "beginCaptures": { "1": { "name": "keyword.other.in.yaffle" } },
          "end": "(?=[@;}]|\\/\\/|\\/\\*)|(?=\\s+(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*<(?:[^<>]|<[^<>]*>)*>)?(?:\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s+\\$?(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from|until)\\b))|$",
          "name": "meta.clause.in.yaffle",
          "patterns": [{ "include": "#expression" }]
        },
        {
          "begin": "\\b(as)\\b",
          "beginCaptures": { "1": { "name": "keyword.other.as.yaffle" } },
          "end": "(?=[@;}]|\\/\\/|\\/\\*)|(?=\\s+(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*<(?:[^<>]|<[^<>]*>)*>)?(?:\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s+\\$?(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from|until)\\b))|$",
          "name": "meta.clause.as.yaffle",
          "patterns": [{ "include": "#expression" }]
        },
        {
          "begin": "\\b(where)\\b",
          "beginCaptures": { "1": { "name": "keyword.other.where.yaffle" } },
          "end": "(?=[@;}]|\\/\\/|\\/\\*)|(?=\\s+(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*<(?:[^<>]|<[^<>]*>)*>)?(?:\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s+\\$?(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from|until)\\b))|$",
          "name": "meta.clause.where.yaffle",
          "patterns": [{ "include": "#expression" }]
        },
        {
          "begin": "\\b(at)\\b",
          "beginCaptures": { "1": { "name": "keyword.other.at.yaffle" } },
          "end": "(?=[@;}]|\\/\\/|\\/\\*)|(?=\\s+(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*<(?:[^<>]|<[^<>]*>)*>)?(?:\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s+\\$?(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from|until)\\b))|$",
          "name": "meta.clause.at.yaffle",
          "patterns": [{ "include": "#expression" }]
        },
        {
          "begin": "\\b(from)\\b",
          "beginCaptures": { "1": { "name": "keyword.other.from.yaffle" } },
          "end": "(?=[@;}]|\\/\\/|\\/\\*)|(?=\\s+(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*<(?:[^<>]|<[^<>]*>)*>)?(?:\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s+\\$?(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from|until)\\b))|$",
          "name": "meta.clause.from.yaffle",
          "patterns": [{ "include": "#expression" }]
        },
        {
          "name": "meta.clause.default.yaffle",
          "begin": "\\?=",
          "beginCaptures": { "0": { "name": "keyword.operator.assignment.default.yaffle" } },
          "end": "(?=[@;}]|\\/\\/|\\/\\*)|(?=\\s+(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*<(?:[^<>]|<[^<>]*>)*>)?(?:\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s+\\$?(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from|until)\\b))|$",
          "patterns": [{ "include": "#expression" }]
        },
        {
          "name": "meta.clause.formula.yaffle",
          "begin": "(?<![=!<>?])=(?![=>])",
          "beginCaptures": { "0": { "name": "keyword.operator.assignment.yaffle" } },
          "end": "(?=[@;}]|\\/\\/|\\/\\*)|(?=\\s+(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*<(?:[^<>]|<[^<>]*>)*>)?(?:\\s*\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))?\\s+\\$?(?!(?:in|as|where|at|from|until)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*(?:[\\[:=@;,)}]|\\?=|\\/\\/|\\/\\*|$)|\\s+(?:in|as|where|at|from|until)\\b))|$",
          "patterns": [{ "include": "#expression" }]
        }
      ]
    },
    "type-parameters": {
      "name": "meta.type-parameters.yaffle",
      "begin": "<",
      "end": ">",
      "beginCaptures": { "0": { "name": "punctuation.definition.typeparameters.begin.yaffle" } },
      "endCaptures": { "0": { "name": "punctuation.definition.typeparameters.end.yaffle" } },
      "patterns": [
        { "include": "#comments" },
        { "match": ",", "name": "punctuation.separator.comma.yaffle" },
        { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "entity.name.type.parameter.yaffle" }
      ]
    },
