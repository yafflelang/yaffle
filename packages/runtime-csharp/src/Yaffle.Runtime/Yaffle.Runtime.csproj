<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Yaffle.Runtime</RootNamespace>
    <AssemblyName>Yaffle.Runtime</AssemblyName>
    <Description>Runtime for C# code generated by the yaffle compiler.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <Version>0.0.3</Version>
  </PropertyGroup>

  <!-- NuGet package metadata (dotnet pack). -->
  <PropertyGroup>
    <PackageId>Yaffle.Runtime</PackageId>
    <Authors>Noah</Authors>
    <PackageLicenseExpression>ISC</PackageLicenseExpression>
    <PackageProjectUrl>https://yafflelang.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yafflelang/yaffle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>yaffle;binary;parser;serialization;file-format</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
